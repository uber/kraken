digraph PieceStateMerge {
  rankdir=TB;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=11, shape=box, style=filled];
  edge [fontname="Helvetica", fontsize=10];
  labelloc="t";
  label="Shared piece-state machine (new): agentstorage + originstorage import one package";

  subgraph cluster_shared {
    label="lib/torrent/storage/piecestate  (NEW, shared)";
    style=rounded; color="#276ef1"; penwidth=2;
    shared [label="pieceStatus enum\npiece struct\ntryMarkDirty\nmarkEmpty / markComplete\npieceStatusMetadata\nrestorePieces", fillcolor="#eef3ff"];
  }

  subgraph cluster_agent {
    label="agentstorage";
    style=rounded; color="#06c167";
    agent [label="WritePiece\nfail-fast on contention\n(errWritePieceConflict)\n— dispatcher already assigns\nwhich peer gets which piece", fillcolor="#e9fbf1"];
  }

  subgraph cluster_origin {
    label="originstorage";
    style=rounded; color="#ff6b35";
    origin [label="ensurePiece / waitForPiece\nblock + poll\n— concurrent HTTP handlers,\nno central coordinator", fillcolor="#fff2e8"];
  }

  agent -> shared;
  origin -> shared;

  note1 [shape=note, style=filled, fillcolor="#fffbe0", label="Before: originstorage/pieces.go (B3a) is planned\nas a near-verbatim copy of agentstorage/pieces.go.\n\nAfter: one shared bookkeeping package, imported by\nboth. Only the wrapping behavior (fail-fast vs.\nblock+poll) stays separate — it reflects a real\ndifference in caller concurrency model."];
}
