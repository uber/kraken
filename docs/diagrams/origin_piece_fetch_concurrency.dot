digraph OriginPieceFetchConcurrency {
  rankdir=LR;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=11, shape=box, style=filled];
  edge [fontname="Helvetica", fontsize=10];
  labelloc="t";
  label="Origin: piece-fetch concurrency";

  subgraph cluster_before {
    label="Before (B3b/B5 as first specified)";
    style=rounded; color="#545454";
    b1 [label="GetPieceReader(pi)", fillcolor="#f5f5f5"];
    b2 [label="ensurePiece(pi) only:\nfetchPiece -> DownloadRange,\nnext piece only requested after this one lands", fillcolor="#f5f5f5"];
    b3 [label="backend worker pool\n(N workers, mostly idle)", shape=cylinder, fillcolor="#f5f5f5"];
    b1 -> b2 -> b3;
  }

  subgraph cluster_after {
    label="After (with B6)";
    style=rounded; color="#276ef1"; penwidth=2;
    a1 [label="GetPieceReader(pi)", fillcolor="#eef3ff"];
    a2a [label="ensurePiece(pi)\n(blocks, this piece)", fillcolor="#eef3ff"];
    a2b [label="prefetchAhead(pi)\n(fire-and-forget)", fillcolor="#fff2e8"];
    a3 [label="fetchSem (bounded)", fillcolor="#fff2e8"];
    a4 [label="up to fetchConcurrency\nconcurrent ensurePiece/DownloadRange calls\nfor pi+1..pi+fetchConcurrency", fillcolor="#eef3ff"];
    a5 [label="backend worker pool\n(N workers, used)", shape=cylinder, fillcolor="#e9fbf1"];
    a1 -> a2a;
    a1 -> a2b -> a3 -> a4 -> a5;
  }

  note1 [shape=note, style=filled, fillcolor="#fffbe0", label="RangeDownloader.DownloadRange shares one backend worker\npool with whole-object Download; the pool parallelizes\nacross concurrent calls, not just by sharding one big call.\nA single piece is too small to shard on its own, so all\nthroughput comes from how many pieces origin submits at once.\n\nPrefetch is driven from GetPieceReader itself, not from A7's\nstreamReader.demand/readahead signal -- origin's Torrent.HasPiece\nis hardcoded true, so that signal never reaches origin's fetch path.\n\nEvery caller of DownloadReader/GetPieceReader benefits --\nB5's whole-blob drain, the Range-read handler, and P2P\npiece serving all go through GetPieceReader."];
}
